# ==============================================================================
# Chop Beta AI - Environment Variables Template
# ==============================================================================

# Appwrite Cloud or Self-Hosted Endpoint (Default: https://cloud.appwrite.io/v1)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Appwrite Project ID (Found in Project Settings)
APPWRITE_PROJECT_ID=your_appwrite_project_id

# Appwrite API Key (Generated in Overview -> API Keys with 'Databases' permissions)
APPWRITE_API_KEY=your_appwrite_secret_api_key

# Appwrite Database ID (ID of your database, e.g., chopbeta_main)
APPWRITE_DATABASE_ID=your_appwrite_database_id

# Appwrite Collection ID (ID of your waitlist collection, e.g., waitlist)
APPWRITE_COLLECTION_ID=waitlist
